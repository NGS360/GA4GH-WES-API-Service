# GA4GH WES API Service — environment template
#
# Copy to .env and edit. Values resolve in this order:
#   1. environment variable
#   2. AWS Secrets Manager, if ENV_SECRETS is set (SQLALCHEMY_DATABASE_URI and
#      INTERNAL_CALLBACK_API_KEY only)
#   3. the default baked into src/wes_service/config.py
#
# See docs/ARCHITECTURE.md section 11 for which settings are actually consumed.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
SQLALCHEMY_DATABASE_URI=mysql+aiomysql://wes_user:wes_password@localhost:3306/wes_db

# ---------------------------------------------------------------------------
# NGS360 API (required)
# Used for workflow resolution, ngs360:// file resolution, and — when
# AUTH_METHOD=api_token — bearer token validation.
# ---------------------------------------------------------------------------
NGS360_API_URL=http://localhost:8000

# ---------------------------------------------------------------------------
# Authentication
#   api_token  validate bearer tokens against NGS360 /api/v1/auth/me (recommended)
#   basic      HTTP Basic against BASIC_AUTH_USERS
#   none       no auth; identity is "anonymous" (development only)
#   oauth2     NOT IMPLEMENTED — every request returns 401
# ---------------------------------------------------------------------------
AUTH_METHOD=api_token

# Only for AUTH_METHOD=basic. Format: username:bcrypt_hash, comma-separated.
# Generate a hash with:
#   python -c "from passlib.context import CryptContext; print(CryptContext(schemes=['bcrypt']).hash('your_password'))"
# NOTE: leaving this empty with AUTH_METHOD=basic accepts ANY username.
BASIC_AUTH_USERS=

# Token validation cache (AUTH_METHOD=api_token). The cache is per worker
# process, so a revoked token stays usable for up to the TTL on each worker.
ENABLE_TOKEN_CACHE=true
TOKEN_CACHE_TTL_SECONDS=300
TOKEN_CACHE_MAX_SIZE=1000

# ---------------------------------------------------------------------------
# Workflow execution (AWS Lambda)
# Read from the process environment directly, not via the Settings class — so
# these do not appear in the startup settings log.
# ---------------------------------------------------------------------------
LAMBDA_FUNCTION_NAME=
LAMBDA_REGION=us-east-1

# ---------------------------------------------------------------------------
# Internal callback endpoint (EventBridge -> Lambda -> this service)
# ---------------------------------------------------------------------------
ENABLE_CALLBACK_ENDPOINT=true

# Shared secret checked against the X-Internal-API-Key header. Must match the
# value configured in the Lambda function. In deployed environments supply this
# through ENV_SECRETS rather than here.
INTERNAL_CALLBACK_API_KEY=

# Externally reachable origin of THIS service, with no trailing slash. The
# callback URL handed to Lambda is CLIENT_ORIGIN + API_PREFIX +
# /internal/callbacks/omics-state-change. If this is empty the URL is relative
# and the Lambda cannot call back — runs then stay QUEUED forever.
CLIENT_ORIGIN=

# ---------------------------------------------------------------------------
# Storage
# S3_BUCKET_NAME does double duty: the attachment bucket when
# STORAGE_BACKEND=s3, and the HealthOmics output prefix
# (s3://$S3_BUCKET_NAME/Project/{ProjectId}/) in all cases.
# ---------------------------------------------------------------------------
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=/var/wes/storage
S3_BUCKET_NAME=
S3_REGION=us-east-1
# Leave blank to use the default boto3 credential chain (instance role, etc.)
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ---------------------------------------------------------------------------
# AWS Secrets Manager (optional)
# When ENV_SECRETS names a secret, SQLALCHEMY_DATABASE_URI and
# INTERNAL_CALLBACK_API_KEY are read from it if not set in the environment.
# ---------------------------------------------------------------------------
ENV_SECRETS=
AWS_REGION=us-east-1

# ---------------------------------------------------------------------------
# API
# ---------------------------------------------------------------------------
API_PREFIX=/ga4gh/wes/v1
CORS_ORIGINS=*
HOST=0.0.0.0
PORT=8000

# ---------------------------------------------------------------------------
# Service metadata — surfaced by GET /service-info
# ---------------------------------------------------------------------------
SERVICE_NAME=GA4GH WES Service
SERVICE_ORGANIZATION_NAME=Your Organization
SERVICE_ORGANIZATION_URL=https://example.com
SERVICE_ENVIRONMENT=development
SERVICE_VERSION=1.1.0
SERVICE_CONTACT_URL=https://example.com/support
SERVICE_DOCUMENTATION_URL=https://example.com/docs
AUTH_INSTRUCTIONS_URL=https://example.com/auth-help

# ---------------------------------------------------------------------------
# Logging
# LOG_LEVEL=DEBUG also enables SQLAlchemy statement echo.
# ---------------------------------------------------------------------------
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Supported workflow types — reported by /service-info. The CWL and WDL keys
# also define which workflow_type values POST /runs accepts.
# ---------------------------------------------------------------------------
SUPPORTED_WES_VERSIONS=1.0.0,1.1.0
WORKFLOW_TYPE_VERSIONS_CWL=v1.0,v1.1,v1.2
WORKFLOW_TYPE_VERSIONS_WDL=1.0,draft-2
WORKFLOW_ENGINE_VERSIONS_CWLTOOL=3.1.20240116213856
SUPPORTED_FILESYSTEM_PROTOCOLS=file,http,https,s3

# ---------------------------------------------------------------------------
# Everything this service reads is listed above. Earlier versions of this file
# also carried WORKFLOW_EXECUTOR, OMICS_REGION, OMICS_ROLE_ARN, LOG_FORMAT,
# MAX_UPLOAD_SIZE_MB, and MAX_ATTACHMENT_COUNT — none of which change any
# behaviour. If you find them in an existing .env you can delete them; see
# docs/ARCHITECTURE.md section 11 for why each one is inert.
#
# Unrecognised variables are silently ignored (extra="ignore" in config.py), so
# a misspelled setting name fails quietly rather than erroring at startup.
# ---------------------------------------------------------------------------
